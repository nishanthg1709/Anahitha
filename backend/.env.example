# Environment variables for Anahitha Backend
# Free-tier Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary free-tier Gemini model
GEMINI_MODEL=gemini-3.8-flash

# Optional free-tier fallback model (e.g. gemini-3.5-flash); leave empty or omit to disable fallback
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Optional Supabase Database & Auth Configuration
# Leave empty to run with in-memory/guest storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Allowed CORS origins (comma-separated list; defaults to http://localhost:5173,http://127.0.0.1:5173)
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

